# Copiar a .env y completar. Nunca commitear el .env real.

# Base de datos (SQLite local; en producción usar Postgres)
DATABASE_URL="file:./dev.db"

# Auth.js — obligatorio. Generar con: openssl rand -base64 32
AUTH_SECRET=""

# Google — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub — https://github.com/settings/developers -> New OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# MercadoPago — https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""
# Clave secreta para validar la firma de los webhooks
MERCADOPAGO_WEBHOOK_SECRET=""
# URL pública del sitio (para back_urls de MercadoPago)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------ Emails
# Remitente que ven los clientes. El dominio tiene que estar verificado en el
# proveedor, si no los mails rebotan o caen en spam.
EMAIL_FROM="Nerd Wear <hola@nerdwear.com.ar>"

# Fuerza el proveedor: smtp | resend | sendgrid. Si se deja vacío, se elige
# solo por las credenciales presentes (y si no hay ninguna, se imprime en
# consola en vez de mandar).
#
# Ojo: en producción, el acceso "entrar con mi email" (link mágico) solo
# aparece si acá hay un proveedor real. Sin proveedor, en desarrollo el link se
# imprime en la consola del servidor.
EMAIL_PROVIDER=""

# Opción A — Resend (API HTTP, recomendada en serverless): https://resend.com/api-keys
RESEND_API_KEY=""

# Opción B — SendGrid (API HTTP): https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=""

# Opción C — SMTP genérico (Gmail, Zoho, el hosting, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# "true" para puerto 465 (SSL). En 587 va en "false".
SMTP_SECURE="false"

# ------------------------------------------------------------------ Envío
# tarifa-plana (implementado) es el único cotizador hoy. Los reales
# (Andreani, Correo Argentino) se agregan y se seleccionan con esta variable.
ENVIO_PROVEEDOR="tarifa-plana"
# Costos en centavos. El envío es gratis por encima de UMBRAL_ENVIO_GRATIS_CENTS.
ENVIO_COSTO_DOMICILIO_CENTS="450000"
ENVIO_COSTO_SUCURSAL_CENTS="350000"

# ------------------------------------------------------------------ Tareas
# Secreto que protege /api/tareas/*. Generar con: openssl rand -base64 32
CRON_SECRET=""

# ------------------------------------------------------ Asistente de diseño
# Genera los estampados desde el backoffice. A diferencia del email, no hay
# versión simulada: cada imagen se paga. Sin credencial, el diálogo aparece
# deshabilitado con la explicación.
ASISTENTE_PROVEEDOR="google"

# API key de Google AI Studio — https://aistudio.google.com/apikey
# OJO: no es la misma que AUTH_GOOGLE_ID/SECRET de arriba. Aquella es OAuth para
# el login; esta es la clave de la API de Gemini, que es la que dibuja.
GOOGLE_API_KEY=""

# Modelo de imagen. gemini-2.5-flash-image es el más rápido y barato;
# gemini-3-pro-image da más calidad y tarda el doble.
ASISTENTE_MODELO_IMAGEN="gemini-2.5-flash-image"

# Endpoint. Solo se cambia para apuntar a otro gateway compatible.
ASISTENTE_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
