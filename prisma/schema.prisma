// Modelo de datos de la tienda de remeras nerd.
// SQLite no valida enums a nivel de base, por eso los campos con valores
// acotados (role, status) se modelan como String y se validan en la app con Zod.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------- Auth (Auth.js)

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // "USER" | "ADMIN". Unicamente ADMIN entra al backoffice.
  role          String    @default("USER")
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  cartItems      CartItem[]
  orders         Order[]
  paymentMethods PaymentMethod[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------- Catálogo

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  // Precio en centavos de peso para no arrastrar errores de redondeo.
  priceCents  Int
  // Precio tachado ("antes"), usado para calcular el badge de descuento.
  listCents   Int?
  imageUrl    String
  // Retro | Los Simpson | Dibujos animados | Cine y series | Memes |
  // Videogames | Cómics y Animé | Literatura y Juguetes | Varios
  category    String
  freeShipping Boolean @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants   ProductVariant[]

  @@index([category])
}

// Cada combinación talle + color es una variante con su propio stock.
model ProductVariant {
  id        String @id @default(cuid())
  productId String
  size      String // S | M | L | XL | XXL
  color     String // Negro | Blanco | Marino | Rojo
  stock     Int    @default(0)
  sku       String @unique

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
}

// ---------------------------------------------------------------- Carrito

model CartItem {
  id        String   @id @default(cuid())
  // Dueño del carrito. Exactamente uno de los dos está presente:
  //   - userId:    carrito de alguien logueado
  //   - cartToken: carrito de invitado, identificado por una cookie
  // La invariante la sostiene lib/carrito.ts, que es el único módulo que
  // escribe acá; no se puede expresar como CHECK sin que Prisma lo lea como
  // "drift" en cada migración.
  userId    String?
  cartToken String?
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  // Última vez que el usuario tocó este ítem. Es la señal de "carrito
  // abandonado": un carrito viejo pero recién modificado NO lo está.
  actualizadoEn DateTime @updatedAt
  // Marca cuándo se mandó el recordatorio de carrito abandonado. Sirve para
  // no repetir el mismo mail todos los días (y que nos marquen como spam).
  // Se vuelve a null cuando el usuario modifica el carrito.
  recordatorioEnviadoEn DateTime?

  user    User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Un usuario no puede tener dos líneas de la misma variante...
  @@unique([userId, variantId])
  // ...ni tampoco un invitado. SQLite trata cada NULL como distinto, así que
  // las dos claves conviven sin pisarse.
  @@unique([cartToken, variantId])
}

// ---------------------------------------------------------------- Pedidos

model Order {
  id      String @id @default(cuid())
  userId  String
  // PENDING | PAID | SHIPPED | CANCELLED
  status  String @default("PENDING")
  // Total del pedido = suma de los ítems + el envío elegido.
  totalCents Int
  // Costo de envío y la opción elegida. Se guarda aparte del total para poder
  // mostrar el desglose y para auditar por qué se cobró lo que se cobró.
  shippingCents  Int     @default(0)
  shippingMethod String?
  // Código de seguimiento que carga el backoffice al despachar.
  trackingCode String?
  // Referencia de la preferencia de MercadoPago, para conciliar el pago.
  mpPreferenceId String?
  mpPaymentId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([status])
}

// Snapshot del producto al momento de la compra: si luego cambia el precio
// o se borra la variante, el pedido histórico queda intacto.
model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  variantId  String?
  productName String
  size       String
  color      String
  quantity   Int
  unitCents  Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------- Medios de pago

// Medios de pago guardados por el usuario. Nunca se persiste el número
// completo de la tarjeta: solo marca, últimos 4 dígitos y vencimiento.
model PaymentMethod {
  id       String @id @default(cuid())
  userId   String
  brand    String // Visa | Mastercard | Amex
  last4    String
  expMonth Int
  expYear  Int
  holder   String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
